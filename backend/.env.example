# Copy this file to .env and fill in real values before running.

APP_NAME=CyberRakshak AI
ENV=development
DEBUG=true

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=cyberrakshak

JWT_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_ENABLED=true

MAX_FILE_SIZE_MB=25
MAX_IMAGE_SIZE_MB=15
MAX_VIDEO_SIZE_MB=100
UPLOAD_DIR=./uploads

RATE_LIMIT_DEFAULT=60/minute

# Optional — leave blank to stay in Demo Mode for these checks
URL_REPUTATION_API_KEY=
MALWARE_SCAN_API_KEY=
BREACH_INTEL_API_KEY=
